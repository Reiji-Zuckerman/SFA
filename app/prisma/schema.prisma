generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  department  String   // IS / FS / SLS / PERM / ITSS / MGMT
  role        String   // ADMIN / MANAGER / MEMBER / VIEWER
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  assignedTasks     Task[]        @relation("TaskOwner")
  activities        Activity[]    @relation("ActivityActor")
  leadsIS           Lead[]        @relation("LeadIS")
  leadsFS           Lead[]        @relation("LeadFS")
  deals             Deal[]        @relation("DealOwner")
  opportunitiesBU   Opportunity[] @relation("OppBU")
  ownedAccounts     Account[]     @relation("AccountOwner")
}

model Account {
  id              String   @id @default(cuid())
  name            String
  nameKana        String?
  industry        String?
  companyType     String?
  tier            String?
  contractStatus  String   @default("未契約")
  mainOwnerId     String?
  slsNeed         Boolean  @default(false)
  permNeed        Boolean  @default(false)
  itssNeed        Boolean  @default(false)
  address         String?
  url             String?
  employeeCount   Int?
  annualRevenue   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mainOwner         User?              @relation("AccountOwner", fields: [mainOwnerId], references: [id])
  contacts          Contact[]
  clientDepartments ClientDepartment[]
  leads             Lead[]
  deals             Deal[]
  opportunities     Opportunity[]
  activities        Activity[]         @relation("ActivityAccount")
}

model Contact {
  id                 String   @id @default(cuid())
  accountId          String
  clientDepartmentId String?
  lastName           String
  firstName          String
  lastNameKana       String?
  firstNameKana      String?
  department         String?
  title              String?
  keyPersonRole      String?
  email              String?
  phone              String?
  notes              String?
  createdAt          DateTime @default(now())

  account            Account            @relation(fields: [accountId], references: [id])
  clientDepartment   ClientDepartment?  @relation(fields: [clientDepartmentId], references: [id])
  opportunities      Opportunity[]      @relation("OppContact")
  activities         Activity[]         @relation("ActivityContact")
  primaryDepartments ClientDepartment[] @relation("DeptPrimaryContact")
}

model ClientDepartment {
  id               String   @id @default(cuid())
  accountId        String
  name             String
  primaryContactId String?
  notes            String?
  createdAt        DateTime @default(now())

  account        Account       @relation(fields: [accountId], references: [id])
  primaryContact Contact?      @relation("DeptPrimaryContact", fields: [primaryContactId], references: [id])
  contacts       Contact[]
  opportunities  Opportunity[] @relation("OppDept")
}

// Lead: IS+FSが一貫管理する営業プロセス。契約締結まで1レコード。
model Lead {
  id              String    @id @default(cuid())
  accountId       String
  name            String
  phase           String    // リード登録 / 架電中 / アポ取得 / 初回商談 / ニーズ確認 / 基本契約交渉 / 契約締結
  channel         String?   // 展示会 / 広告 / 紹介 / HP問合せ / 自社開拓 / その他
  isOwnerId       String?
  fsOwnerId       String?
  reapproachDate  DateTime?
  lostReason      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account  Account  @relation(fields: [accountId], references: [id])
  isOwner  User?    @relation("LeadIS", fields: [isOwnerId], references: [id])
  fsOwner  User?    @relation("LeadFS", fields: [fsOwnerId], references: [id])
  deals    Deal[]
}

// Deal: 商談。Leadが「初回商談」以降に作成可能。シンプルなレコード（フェーズ管理なし）。
model Deal {
  id          String   @id @default(cuid())
  leadId      String
  accountId   String
  name        String
  content     String?  // 商談内容
  ownerId     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead          Lead          @relation(fields: [leadId], references: [id])
  account       Account       @relation(fields: [accountId], references: [id])
  owner         User?         @relation("DealOwner", fields: [ownerId], references: [id])
  opportunities Opportunity[]
}

// Opportunity: 事業部が管理する具体的な案件。Deal配下に紐付け。
model Opportunity {
  id                  String    @id @default(cuid())
  parentOpportunityId String?
  dealId              String
  accountId           String
  clientDepartmentId  String?
  contactId           String?
  recordType          String    // SLS_PROJECT / PERM_JOB / ITSS_PROJECT / ITSS_JOB
  name                String
  phase               String
  buOwnerId           String?
  expectedAmount      Int?
  expectedCloseDate   DateTime?
  reapproachDate      DateTime?
  lostReason          String?
  powerAgelessUrl     String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  parentOpportunity  Opportunity?       @relation("OppParent", fields: [parentOpportunityId], references: [id])
  childOpportunities Opportunity[]      @relation("OppParent")
  deal               Deal               @relation(fields: [dealId], references: [id])
  account            Account            @relation(fields: [accountId], references: [id])
  clientDepartment   ClientDepartment?  @relation("OppDept", fields: [clientDepartmentId], references: [id])
  contact            Contact?           @relation("OppContact", fields: [contactId], references: [id])
  buOwner            User?              @relation("OppBU", fields: [buOwnerId], references: [id])
  tasks              Task[]
  activities         Activity[]
}

model Task {
  id            String    @id @default(cuid())
  opportunityId String
  name          String
  description   String?
  ownerId       String
  status        String    @default("未着手")
  dueDate       DateTime?
  priority      String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  owner       User        @relation("TaskOwner", fields: [ownerId], references: [id])
}

model Activity {
  id            String   @id @default(cuid())
  opportunityId String?
  accountId     String?
  contactId     String?
  activityType  String
  activityDate  DateTime
  subject       String
  content       String?
  actorId       String
  createdAt     DateTime @default(now())

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  account     Account?     @relation("ActivityAccount", fields: [accountId], references: [id])
  contact     Contact?     @relation("ActivityContact", fields: [contactId], references: [id])
  actor       User         @relation("ActivityActor", fields: [actorId], references: [id])
}
